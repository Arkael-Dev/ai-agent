#!/usr/bin/env bash
# Based on ExTV/termux-bubble (https://github.com/ExTV/termux-bubble), GPL-3.0.
# Original author: ExTV. Modified by Arkael-Dev for Linux desktops.
set -u

# ai — one command for everything. Installed as `ai` by install.sh.
#   ai                 GUI menu on a desktop, plain-text menu in a bare terminal
#   ai gui             force the graphical menu
#   ai chat            chat in the terminal
#   ai setup           choose AI, API key and model
#   ai update          git pull
#   ai "question"      one-shot answer
#
# The Android/Termux floating bubble is not part of this branch: on a desktop
# you get a real dialog window, in SSH/tty you get the same menu drawn as text.

resolve_path() {
    local p="$1" d
    while [ -L "$p" ]; do
        d="$(cd -P "$(dirname "$p")" && pwd)"
        p="$(readlink "$p")"
        case "$p" in /*) ;; *) p="$d/$p" ;; esac
    done
    d="$(cd -P "$(dirname "$p")" && pwd)"
    printf '%s/%s\n' "$d" "$(basename "$p")"
}
SELF="$(resolve_path "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SELF")"
CHAT="$DIR/ai-agent-chat.sh"
# Platform: linux / macos (Termux is not a target of this build)
if [ "$(uname -s 2>/dev/null)" = Darwin ]; then PLATFORM=macos; else PLATFORM=linux; fi

CONFIG_DIR="${AI_CONFIG_DIR:-$HOME/.config/ai-agent}"
GUI_LOG="$CONFIG_DIR/gui.log"

cfg_get() { grep -m1 "^$1=" "$CONFIG_DIR/config" 2>/dev/null | cut -d= -f2-; }
keyvar() {
    case "$1" in
        deepseek) echo DEEPSEEK_API_KEY ;; openai) echo OPENAI_API_KEY ;;
        gemini) echo GEMINI_API_KEY ;; claude) echo ANTHROPIC_API_KEY ;;
        openrouter) echo OPENROUTER_API_KEY ;; groq) echo GROQ_API_KEY ;;
        *) echo AI_API_KEY ;;
    esac
}

# ── is there a desktop to draw on? ──────────────────────────────────────────
have_gui() {
    [ -n "${AI_NO_GUI:-}" ] && return 1
    # a terminal inside $DISPLAY still counts: dialog needs the X connection
    if [ "$PLATFORM" = macos ]; then
        command -v osascript >/dev/null 2>&1 && return 0
        return 1
    fi
    if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then return 1; fi
    command -v dialog >/dev/null 2>&1 && return 0
    command -v whiptail >/dev/null 2>&1 && return 0
    return 1
}

# which dialog implementation do we have?
DIALOG=""
dialog_bin() {
    [ -n "$DIALOG" ] && { echo "$DIALOG"; return; }
    if command -v dialog >/dev/null 2>&1; then DIALOG=dialog
    elif command -v whiptail >/dev/null 2>&1; then DIALOG=whiptail
    else return 1; fi
    echo "$DIALOG"
}

# terminal emulators we can open a GUI chat window in
terminal_bin() {
    local t
    for t in x-terminal-emulator gnome-terminal konsole xfce4-terminal \
             alacritty kitty foot tilix terminator lxterminal mate-terminal \
             xterm urxvt st wezterm; do
        command -v "$t" >/dev/null 2>&1 && { echo "$t"; return 0; }
    done
    return 1
}

# open $1... (a command) in a new terminal window; falls back to the current tty
open_terminal() {
    local term
    if [ "$PLATFORM" = macos ]; then
        osascript -e "tell application \"Terminal\" to do script \"$*\"" >/dev/null 2>&1 && return 0
    fi
    term="$(terminal_bin)" || return 1
    case "$term" in
        gnome-terminal) exec_nohup "$term" -- bash -lc "$*" ;;
        konsole)        exec_nohup "$term" -e bash -lc "$*" ;;
        xfce4-terminal) exec_nohup "$term" -x bash -lc "$*" ;;
        alacritty)      exec_nohup "$term" -e bash -lc "$*" ;;
        kitty)          exec_nohup "$term" bash -lc "$*" ;;
        foot)           exec_nohup "$term" bash -lc "$*" ;;
        wezterm)        exec_nohup "$term" start -- bash -lc "$*" ;;
        tilix|terminator) exec_nohup "$term" -e bash -lc "$*" ;;
        xterm|urxvt|lxterminal|mate-terminal|st|x-terminal-emulator)
                        exec_nohup "$term" -e bash -lc "$*" ;;
        *) return 1 ;;
    esac
}
exec_nohup() {
    mkdir -p "$CONFIG_DIR"
    nohup "$@" >>"$GUI_LOG" 2>&1 </dev/null &
    disown 2>/dev/null
}

status_text() {
    local prov model key kv host
    prov="$(cfg_get AI_PROVIDER)"; prov="${prov:-deepseek}"
    model="$(cfg_get "MODEL_$prov")"; model="${model:-default}"
    if [ "$prov" = ollama ]; then key="local"
    else kv="$(keyvar "$prov")"; if [ -n "$(cfg_get "$kv")" ]; then key="key ✓"; else key="NO KEY — choose option 4"; fi; fi
    host="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-$(uname -s)}")"
    printf 'AI: %s · %s · %s\nHost: %s' "$prov" "$model" "$key" "$host"
}

do_update() {
    if [ -d "$DIR/.git" ]; then git -C "$DIR" pull --ff-only && echo "Updated."; else echo "Not a git checkout: $DIR"; fi
}

# ── GUI menu (dialog / whiptail) ────────────────────────────────────────────
gui_menu() {
    local d ans rc
    d="$(dialog_bin)" || return 1
    while :; do
        # dialog writes the choice to stderr and the UI to stdout
        # (the classic 3>&1 1>&2 2>&3 swap breaks on Termux, so swap explicitly)
        ans="$("$d" --title "AI Agent" --backtitle "$(status_text | tr '\n' ' ')" \
                 --menu "Choose an action" 16 62 6 \
                 1 "Chat in a new terminal window" \
                 2 "Chat in this terminal" \
                 3 "Choose AI / API key / model" \
                 4 "Update" \
                 5 "Close" 3>&1 1>&3- 2>&1)"
        rc=$?
        [ $rc -ne 0 ] && return 0            # Esc / Cancel
        ans="$(printf '%s\n' "$ans" | tail -n1)"   # drop any UI text, keep the tag
        case "$ans" in
            1) open_terminal "bash '$CHAT' --no-menu" \
                 || "$d" --title "AI Agent" --msgbox "No terminal emulator found.\nUse 'Chat in this terminal' instead." 8 60 ;;
            2) return 2 ;;                    # caller takes over the tty
            3) bash "$CHAT" --setup ;;
            4) do_update | { "$d" --title "Update" --programbox 10 62; } ;;
            5) return 0 ;;
        esac
    done
}

# ── text menu (SSH, tty, no X) ──────────────────────────────────────────────
if [ -t 1 ]; then C_ACC=$'\e[38;5;204m'; C_RST=$'\e[0m'; else C_ACC=""; C_RST=""; fi

text_menu() {
    local ans
    while :; do
        echo
        echo "${C_ACC}⚡ AI Agent${C_RST}"
        status_text | sed 's/^/ /'
        echo
        echo "  1) Chat in terminal"
        echo "  4) Choose AI / API key / model"
        echo "  5) Update"
        echo "  q) Quit"
        read -r -p "› " ans || { echo; return 0; }
        case "${ans//[$'\n\r\t ']/}" in
            1) bash "$CHAT" --no-menu ;;
            4) bash "$CHAT" --setup ;;
            5) do_update ;;
            q|Q) return 0 ;;
            "") ;;
            *) echo "  Pick 1, 4, 5 or q." ;;
        esac
    done
}

FORCE_GUI=0
menu() {
    if [ "$FORCE_GUI" = 1 ] || have_gui; then
        gui_menu; local r=$?
        [ $r -eq 2 ] && bash "$CHAT" --no-menu
        return 0
    fi
    text_menu
}

case "${1:-}" in
    "")        menu ;;
    gui)       FORCE_GUI=1; menu ;;
    chat)      shift; exec bash "$CHAT" "$@" ;;
    setup)     exec bash "$CHAT" --setup ;;
    update)    do_update ;;
    doctor)
        echo "ai-agent — environment check"
        echo "platform : $PLATFORM"
        echo "shell    : $BASH_VERSION"
        echo "config   : $CONFIG_DIR"
        if have_gui; then echo "gui      : yes ($(dialog_bin))"; else echo "gui      : no (text menu)"; fi
        if t="$(terminal_bin)"; then echo "terminal : $t"; else echo "terminal : none found"; fi
        for c in bash curl jq sed; do
            if command -v "$c" >/dev/null 2>&1; then printf '  %-8s ok   %s\n' "$c" "$(command -v "$c")"; else printf '  %-8s MISSING\n' "$c"; fi
        done
        ;;
    bubble|stop) echo "The floating bubble was removed; this build uses a GUI dialog instead. Run: ai" ;;
    -h|--help|help) sed -n '5,13p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *)         exec bash "$CHAT" "$@" ;;
esac
