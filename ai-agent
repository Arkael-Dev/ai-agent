#!/data/data/com.termux/files/usr/bin/bash
# Based on ExTV/termux-bubble (https://github.com/ExTV/termux-bubble), GPL-3.0.
# Original author: ExTV. Modified by Arkael-Dev.
set -u

# ai — one command for everything. Installed as `ai` by install.sh.
#   ai                 menu (chat / bubble / settings / update)
#   ai chat            chat in the terminal
#   ai bubble          start the floating bubble (GUI, Termux only)
#   ai stop            stop the bubble
#   ai setup           choose AI, API key and model
#   ai update          git pull
#   ai autostart on|off   open this menu on every new Termux session
#   ai "question"      one-shot answer

# portable realpath: `readlink -f` is GNU-only, macOS/BSD lack it
resolve_path() {
    local p="$1" d
    while [ -L "$p" ]; do
        d="$(cd -P "$(dirname "$p")" && pwd)"
        p="$(readlink "$p")"
        case "$p" in /*) ;; *) p="$d/$p" ;; esac
    done
    d="$(cd -P "$(dirname "$p")" && pwd)"
    printf '%s/%s\n' "$d" "$(basename "$p")"
}
SELF="$(resolve_path "${BASH_SOURCE[0]}")"
DIR="$(dirname "$SELF")"
CHAT="$DIR/ai-agent-chat.sh"
# The bubble and the Termux autostart hook only exist on Android/Termux.
if [ -n "${TERMUX_VERSION:-}" ] && [ -n "${PREFIX:-}" ]; then IS_TERMUX=1; else IS_TERMUX=0; fi

BUBBLE="$DIR/ai-agent-bubble.sh"
CONFIG_DIR="${AI_CONFIG_DIR:-$HOME/.config/ai-agent}"
LOG="$CONFIG_DIR/bubble.log"
MARK_BEGIN="# >>> ai-agent autostart >>>"
MARK_END="# <<< ai-agent autostart <<<"

if [ -t 1 ]; then C_ACC=$'\e[38;5;204m'; C_DIM=$'\e[2m'; C_RST=$'\e[0m'; else C_ACC=""; C_DIM=""; C_RST=""; fi

cfg_get() { grep -m1 "^$1=" "$CONFIG_DIR/config" 2>/dev/null | cut -d= -f2-; }
keyvar() {
    case "$1" in
        deepseek) echo DEEPSEEK_API_KEY ;; openai) echo OPENAI_API_KEY ;;
        gemini) echo GEMINI_API_KEY ;; claude) echo ANTHROPIC_API_KEY ;;
        openrouter) echo OPENROUTER_API_KEY ;; groq) echo GROQ_API_KEY ;;
        *) echo AI_API_KEY ;;
    esac
}
bubble_running() { pgrep -f 'ai-agent-bubble\.sh' >/dev/null 2>&1; }
rc_files() { for f in "$HOME/.zshrc" "$HOME/.bashrc"; do [ -f "$f" ] && echo "$f"; done; }
autostart_on_p() { local f; for f in $(rc_files); do grep -qF "$MARK_BEGIN" "$f" && return 0; done; return 1; }

AUTO_LINE='[ -t 0 ] && [ -t 1 ] && [ -z "${AI_AGENT_SKIP:-}" ] && command -v ai >/dev/null 2>&1 && ai --auto && exit'
# GNU sed accepts `-i`, BSD/macOS requires `-i ''`; detect once and reuse.
if sed --version >/dev/null 2>&1; then SED_INPLACE=(sed -i); else SED_INPLACE=(sed -i ''); fi
autostart_strip() { local f; for f in $(rc_files); do "${SED_INPLACE[@]}" "\|$MARK_BEGIN|,\|$MARK_END|d" "$f"; done; }
autostart_write() {
    local f
    [ -f "$HOME/.bashrc" ] || touch "$HOME/.bashrc"
    for f in $(rc_files); do
        printf '\n%s\n%s\n%s\n' "$MARK_BEGIN" "$AUTO_LINE" "$MARK_END" >> "$f"
    done
}
# old installs wrote a block without "--auto"; upgrade it in place
autostart_migrate() {
    local f
    autostart_on_p || return 0
    for f in $(rc_files); do
        grep -qF "$MARK_BEGIN" "$f" && ! grep -qF 'ai --auto' "$f" && { autostart_strip; autostart_write; return 0; }
    done
}

autostart() {
    case "${1:-}" in
        on)  autostart_strip; autostart_write
             echo "Menu will open on every new Termux session. q closes the session, s keeps the shell. Turn off: ai autostart off" ;;
        off) autostart_strip; echo "Autostart off." ;;
        *)   echo "Use: ai autostart on|off"; return 1 ;;
    esac
}

start_bubble() {
    if ! command -v tgui-bash >/dev/null 2>&1; then
        echo "The bubble needs termux-gui-bash:  pkg install termux-gui-bash"; return 1
    fi
    if bubble_running; then echo "Bubble is already running."; return 0; fi
    mkdir -p "$CONFIG_DIR"
    nohup "$BUBBLE" >"$LOG" 2>&1 </dev/null &
    disown 2>/dev/null
    sleep 2
    if bubble_running; then
        echo "${C_ACC}⚡${C_RST} Bubble is running — look at your screen. (Stop: ai stop)"
    else
        echo "The bubble stopped right away. Log:"; tail -n 8 "$LOG" 2>/dev/null
    fi
}
stop_bubble() {
    if bubble_running; then pkill -f 'ai-agent-bubble\.sh'; echo "Bubble stopped."; else echo "Bubble is not running."; fi
}
do_update() {
    if [ -d "$DIR/.git" ]; then git -C "$DIR" pull --ff-only && echo "Updated."; else echo "Not a git checkout: $DIR"; fi
}

status_line() {
    local prov model key kv bub auto
    prov="$(cfg_get AI_PROVIDER)"; prov="${prov:-deepseek}"
    model="$(cfg_get "MODEL_$prov")"; model="${model:-default}"
    if [ "$prov" = ollama ]; then key="local"
    else kv="$(keyvar "$prov")"; if [ -n "$(cfg_get "$kv")" ]; then key="key ✓"; else key="NO KEY — use option 4"; fi; fi
    echo " AI: ${C_ACC}$prov${C_RST} · $model · $key"
    if [ "$IS_TERMUX" = 1 ]; then
        bubble_running && bub="running ●" || bub="stopped"
        echo " Bubble: $bub"
    else
        echo " Host: $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-$(uname -s)}")"
    fi
}

AUTO=0
menu() {
    local ans a
    autostart_migrate
    while :; do
        echo
        echo "${C_ACC}⚡ AI Agent${C_RST}"
        status_line
        echo
        echo "  1) Chat in terminal"
        if [ "$IS_TERMUX" = 1 ]; then
            echo "  2) Start floating bubble (GUI)"
            echo "  3) Stop bubble"
        fi
        echo "  4) Choose AI / API key / model"
        echo "  5) Update"
        if [ "$IS_TERMUX" = 1 ]; then
            autostart_on_p && a="ON" || a="OFF"
            echo "  6) Open this menu when Termux starts: $a"
        fi
        if [ "$AUTO" = 1 ]; then
            echo "  s) Shell (stay in Termux)"
            echo "  q) Quit (close this session)"
        else
            echo "  q) Quit"
        fi
        read -r -p "› " ans || { echo; return 0; }
        case "${ans//[$'\n\r\t ']/}" in
            1) bash "$CHAT" --no-menu ;;   # AI is already shown above; /menu inside chat switches it
            2) if [ "$IS_TERMUX" = 1 ]; then start_bubble; else echo "  The bubble is Termux-only — use option 1."; fi ;;
            3) if [ "$IS_TERMUX" = 1 ]; then stop_bubble; else echo "  The bubble is Termux-only — use option 1."; fi ;;
            4) bash "$CHAT" --setup ;;
            5) do_update ;;
            6) if [ "$IS_TERMUX" = 1 ]; then if autostart_on_p; then autostart off; else autostart on; fi; else echo "  Autostart is Termux-only."; fi ;;
            s|S) if [ "$AUTO" = 1 ]; then return 1; else echo "  Pick 1-6 or q."; fi ;;
            q|Q) return 0 ;;
            "") ;;
            *) echo "  Pick 1-6 or q." ;;
        esac
    done
}

case "${1:-}" in
    "")        menu ;;
    --auto)    AUTO=1; menu ;;     # used by autostart: q -> exit 0 (closes session), s -> exit 1 (keeps shell)
    chat)      shift; exec bash "$CHAT" "$@" ;;
    bubble)    start_bubble ;;
    stop)      stop_bubble ;;
    setup)     exec bash "$CHAT" --setup ;;
    update)    do_update ;;
    autostart) autostart "${2:-}" ;;
    -h|--help|help) sed -n '3,12p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *)         exec bash "$CHAT" "$@" ;;     # ai "question" -> one-shot
esac
